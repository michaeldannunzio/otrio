# Copy to `.env.local` and edit. `.env.local` is gitignored; this file is not.
#
# Only variables prefixed VITE_ are exposed to browser code. Anything you put
# behind that prefix ends up in the JavaScript bundle and is readable by anyone
# who opens devtools — so it is fine for a STUN URL and NOT fine for a secret
# you actually care about. TURN credentials below are the awkward middle case:
# see the note on them.

# --- Which backend the client talks to -------------------------------------
# 'hosted' -> the Node WebSocket server in server/ relays every move.
# 'p2p'    -> WebRTC data channels between phones; the server only introduces
#             them, then steps out of the way.
VITE_TRANSPORT=hosted

# --- Hosted (WebSocket) transport ------------------------------------------
# Leave unset to use a same-origin relative /ws, which is what you want both in
# dev (vite proxies it to the Node server) and in the single-container deploy.
# Set it only when the frontend and the socket are on different hostnames.
#   e.g. wss://otrio.fly.dev/ws
# Must be wss:// (not ws://) if the page itself is served over https.
# VITE_OTRIO_SERVER_URL=

# --- Signalling, for the p2p transport -------------------------------------
# A wss:// / ws:// URL, or the literal `broadcast:otrio` to signal between tabs
# of the same browser via BroadcastChannel with no server at all. The broadcast
# mode is the fastest way to test four players on one laptop.
# VITE_OTRIO_SIGNALING_URL=broadcast:otrio

# --- ICE: how two phones find each other ------------------------------------
# Comma-separated. Defaults to a public STUN server if unset.
# VITE_STUN_URLS=stun:stun.l.google.com:19302

# TURN relays traffic when a direct connection is impossible (symmetric NAT,
# some mobile carriers). It is not needed for phones on the same Wi-Fi.
#
# Note the trade-off honestly: putting TURN credentials in a VITE_ variable
# ships them to every visitor. That is acceptable for short-lived credentials
# from a TURN provider that issues them per-session; it is not acceptable for
# a permanent username/password on a relay you pay for by the gigabyte.
# VITE_TURN_URLS=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# --- Dev server -------------------------------------------------------------
# Set to 1 to require HTTPS (fails loudly if ./certs is missing), 0 to force
# plain HTTP. Unset = use HTTPS automatically if ./certs/dev-cert.pem exists.
# VITE_DEV_HTTPS=

# --- Server process (NOT browser-visible; no VITE_ prefix) ------------------
# Where the Vite dev-server proxy forwards /ws and /api.
# OTRIO_SERVER_URL=http://127.0.0.1:8787
#
# Port the client falls back to when no server URL is set and the page is not
# being served from the server itself.
# VITE_OTRIO_SERVER_PORT=8787

# Read by server/ itself. Hosts inject PORT automatically.
# PORT=8787
# HOST=0.0.0.0
#
# Comma-separated origins allowed to open a socket. Unset means no allowlist,
# which is right until you know the deployed front-end origin.
# OTRIO_ALLOWED_ORIGINS=
#
# OTRIO_STATIC_DIR is NOT implemented — the server serves no files. It is set
# in the deploy configs but read by nothing. See docs/DEPLOYMENT.md.
